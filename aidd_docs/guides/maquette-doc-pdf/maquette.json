          {
            "style": "Intertitre-1",
            "texte": "Préparer le fichier"
          },
          {
            "style": "Courant",
            "texte": "Le fichier du catalogue est un tableur enregistré au format CSV. Chaque ligne décrit une référence, chaque colonne porte un titre fixe : l’ordre des colonnes est libre, leurs titres ne le sont pas."
          },
          {
            "style": "Courant",
            "texte": "Avant l’envoi, ouvrez le fichier et vérifiez que les prix et les dimensions sont renseignés."
          },
          {
            "style": "Liste-puce",
            "texte": "Enregistrer le tableur en CSV, séparateur point-virgule."
          },
          {
            "style": "Liste-puce",
            "texte": "Conserver les 23 titres de colonne, sans en ajouter ni en retirer."
          },
          {
            "style": "Liste-puce",
            "texte": "Laisser vide une cellule sans valeur plutôt que d’y écrire un zéro."
          },
          {
            "style": "Encadré-info",
            "libelle": "Bon à savoir",
            "texte": "un fichier refusé n’efface jamais le catalogue en ligne : rien n’est modifié tant que l’import n’a pas réussi."
          }
        ]
      },
