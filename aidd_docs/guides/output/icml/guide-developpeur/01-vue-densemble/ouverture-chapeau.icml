    <StoryPreference OpticalMarginAlignment="false" OpticalMarginSize="12" />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Chapeau">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> est une application Rust qui exporte des comptes IMAP vers des notes Markdown, les trie dans une arborescence de destinations et peut supprimer du serveur les messages déjà traités. Ce chapitre situe le code : le crate, ses modules, ses points d’entrée et les conventions qui valent partout.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
