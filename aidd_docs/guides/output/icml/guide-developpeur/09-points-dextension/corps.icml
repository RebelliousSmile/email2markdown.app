<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>C’est l’extension la plus coûteuse, parce que les cinq types de règles existants sont dupliqués. Une recherche de </Content>
  </CharacterStyleRange>
