  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>DestinationRule::Subject</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> dans </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>src/</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> donne les endroits à toucher.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
