      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>corrige les corps HTML en Markdown dans le répertoire d’export d’un compte (</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>run_fix_html</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>)</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
