<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>export</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> connecte les comptes IMAP configurés, convertit chaque message en note Markdown dans le répertoire d’export, puis déplace la note vers sa destination selon </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>destinations.yaml</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Le flux complet tient en quatre temps :</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num" NumberingContinue="false">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>connexion IMAP et téléchargement des messages ;</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>conversion en note Markdown, dans le répertoire d’export qui sert de zone tampon ;</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>calcul de la destination d’après les règles de </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>destinations.yaml</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> ;</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>déplacement vers </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>notes_dir/&lt;chemin&gt;/&lt;dossiers datés&gt;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>, selon le motif </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>date_layout</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> (par défaut </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>&lt;Année&gt;/&lt;Mois&gt;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>).</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Si aucune règle ne correspond, la note atterrit dans le dossier fourre-tout, </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>notes_dir/Perso/Messy/Emails</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>, suivi des dossiers datés. Si </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>destinations.yaml</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> est absent ou non configuré, un avertissement s’affiche et tous les messages tombent dans ce fourre-tout : l’export continue sans erreur fatale.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown export [OPTIONS]</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<Table AppliedTableStyle="TableStyle/Tableau" HeaderRowCount="1" BodyRowCount="5" ColumnCount="2">
  <Column Name="0" SingleColumnWidth="160.3556" />
  <Column Name="1" SingleColumnWidth="199.6444" />
  <Cell Name="0:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Option</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Description</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--list-accounts</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>liste les comptes configurés dans </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>accounts.yaml</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>, puis quitte</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>-a, --account &lt;NOM&gt;</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>exporte seulement le ou les comptes indiqués, séparés par des virgules</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>-c, --config &lt;CHEMIN&gt;</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>fichier de configuration ; par défaut, le répertoire de configuration du système</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>-d, --debug</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>mode verbeux, avec la sortie IMAP brute</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:5" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--delete-after-export</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:5" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>supprime les messages du serveur après l’export</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
</Table>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Encadré-attention">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Encadré-libellé">
    <Content>Attention</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> : </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>--delete-after-export</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> supprime des messages sur le serveur. Une suppression exige une preuve de source complète dans la note ; le chapitre 6 décrit ce garde-fou.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Quelques exemples :</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown export</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>&#x2028;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown export --list-accounts</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>&#x2028;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown export --account Gmail</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>&#x2028;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown export --account Gmail,Outlook</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>&#x2028;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown export --account Gmail --debug</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>&#x2028;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown export --config /chemin/vers/accounts.yaml</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>&#x2028;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown export --account Gmail --delete-after-export</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-1">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>dest</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>dest</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> gère </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>destinations.yaml</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>. Sans sous-commande, elle ouvre l’éditeur interactif guidé.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<Table AppliedTableStyle="TableStyle/Tableau" HeaderRowCount="1" BodyRowCount="4" ColumnCount="2">
  <Column Name="0" SingleColumnWidth="128.5793" />
  <Column Name="1" SingleColumnWidth="231.4207" />
  <Cell Name="0:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Commande</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Effet</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>dest</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>lance l’éditeur interactif</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>dest list</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>affiche les destinations et leurs règles, et repère les anomalies</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>dest add &lt;CHEMIN&gt; [OPTIONS]</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>ajoute une destination, avec ou sans règle</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>dest suggest</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>propose, de façon interactive, des règles à partir des messages déjà tombés dans le fourre-tout</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
</Table>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>&lt;CHEMIN&gt;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> est un chemin relatif sous </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>notes_dir</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>, par exemple </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>Perso/Banque</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>. Un chemin nu, sans règle, est une option de classement. Les options de </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>dest add</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> :</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<Table AppliedTableStyle="TableStyle/Tableau" HeaderRowCount="1" BodyRowCount="7" ColumnCount="2">
  <Column Name="0" SingleColumnWidth="146.8706" />
  <Column Name="1" SingleColumnWidth="213.1294" />
  <Cell Name="0:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Option</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Règle ajoutée</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--domain &lt;DOMAINE&gt;</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>les messages de ce domaine d’expéditeur</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--from &lt;ADRESSE&gt;</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>les messages de cette adresse exacte</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--correspondent &lt;ADRESSE&gt;</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>les messages où cette adresse figure dans From, To, Cc ou Bcc</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--subject &lt;MOT&gt;</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>les messages dont le sujet contient ce mot</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:5" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--account &lt;NOM&gt;</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:5" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>les messages reçus sur ce compte IMAP</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:6" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--note &lt;TEXTE&gt;</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:6" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>une note qui décrit la destination</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:7" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--default</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:7" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>marque la destination comme dossier par défaut</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
</Table>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Quelques exemples :</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown dest</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>&#x2028;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown dest list</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>&#x2028;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown dest add &quot;Perso/Famille&quot;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>&#x2028;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown dest add &quot;Perso/Banque&quot; --domain mabanque.fr --subject relevé --note &quot;factures&quot;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>&#x2028;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown dest add &quot;Pro/Clients/Acme&quot; --correspondent contact@acme.example</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>&#x2028;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown dest suggest</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Lancé sans sous-commande, </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>dest</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> ouvre une liste numérotée que filtre une sous-chaîne du chemin, puis des actions au clavier la pilotent : </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>a</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> ajoute, </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>e N</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> édite la note, </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>s N</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> supprime, </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>r N</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> gère les règles, </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>d N</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> définit le défaut, </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>f</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> filtre à nouveau et </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>q</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> quitte. Chaque action est sauvegardée immédiatement. </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>dest suggest</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> regroupe les messages du dossier par défaut par domaine d’expéditeur ; aucun message déjà exporté n’est déplacé, les règles ne valent que pour les exports suivants.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-1">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Les commandes de maintenance</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Ces trois commandes agissent sur des notes ou des messages déjà exportés. Les deux premières ne modifient rien sans demande explicite.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-2">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>audit-server</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>audit-server</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> fait un recensement en lecture seule. Pour chaque message encore présent sur le serveur d’un compte, elle indique pourquoi : traité avec ou sans preuve, rangé en note, ou jamais exporté. Rien n’est modifié.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown audit-server &lt;COMPTE&gt; [OPTIONS]</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<Table AppliedTableStyle="TableStyle/Tableau" HeaderRowCount="1" BodyRowCount="4" ColumnCount="2">
  <Column Name="0" SingleColumnWidth="115.4815" />
  <Column Name="1" SingleColumnWidth="244.5185" />
  <Cell Name="0:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Option</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Description</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--folder &lt;DOSSIER&gt;</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>n’audite que ce dossier, par son nom affiché ou son nom IMAP brut</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--details</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>liste chaque message, pas seulement les totaux</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--uid &lt;UID&gt;</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>compare l’identité d’un message lue en RFC822 et dans son bloc d’en-têtes ; exige </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--folder</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>-c, --config &lt;CHEMIN&gt;</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>fichier de configuration</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
</Table>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown audit-server Gmail</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>&#x2028;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown audit-server Gmail --folder INBOX --details</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-2">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>link-quotes</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>link-quotes</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> remplace, dans un coffre existant, les messages cités par des wikilinks vers leurs notes. Sans option, elle ne fait qu’un essai : elle liste ce qui serait lié et pourquoi le reste reste du texte.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown link-quotes &lt;COFFRE&gt; [--apply --backup &lt;DOSSIER&gt;]</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<Table AppliedTableStyle="TableStyle/Tableau" HeaderRowCount="1" BodyRowCount="2" ColumnCount="2">
  <Column Name="0" SingleColumnWidth="111.4769" />
  <Column Name="1" SingleColumnWidth="248.5231" />
  <Cell Name="0:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Option</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Description</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--apply</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>réécrit les notes ; sans elle, rien n’est écrit</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--backup &lt;DOSSIER&gt;</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>dossier extérieur au coffre qui reçoit une copie de chaque note avant sa réécriture</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
</Table>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>--apply</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> exige </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>--backup</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown link-quotes /chemin/vers/le/coffre</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>&#x2028;</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown link-quotes /chemin/vers/le/coffre --apply --backup /chemin/hors/coffre</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-2">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>repair-attachments</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>repair-attachments</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> concerne les notes exportées avec l’ancien schéma centralisé (</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>&lt;compte&gt;/attachments/&lt;dossier&gt;/</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>), puis déplacées. Elle range les pièces jointes à côté de leur note et ramène le frontmatter à des noms de fichier seuls.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown repair-attachments --account &lt;NOM&gt; [--dry-run]</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<Table AppliedTableStyle="TableStyle/Tableau" HeaderRowCount="1" BodyRowCount="3" ColumnCount="2">
  <Column Name="0" SingleColumnWidth="115.4815" />
  <Column Name="1" SingleColumnWidth="244.5185" />
  <Cell Name="0:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Option</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Description</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>-a, --account &lt;NOM&gt;</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>compte dont le dossier de pièces jointes sert de source ; obligatoire</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>--dry-run</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>affiche les changements sans les appliquer</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>-c, --config &lt;CHEMIN&gt;</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>fichier de configuration</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
</Table>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown repair-attachments --account Gmail --dry-run</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Encadré-attention">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Encadré-libellé">
    <Content>Attention</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> : </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>repair-attachments</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> applique ses changements par défaut et n’a une simulation qu’avec </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>--dry-run</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>. </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>link-quotes</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> fait l’inverse, et c’est le modèle à suivre pour une nouvelle commande destructrice (chapitre 9).</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-1">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>contextual</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> et </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>tray</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-2">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>contextual</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>contextual</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> ouvre la fenêtre de recherche directement dans une destination exacte de </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>destinations.yaml</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown contextual &quot;/chemin/Notes/Pro/Client&quot;</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Le programme n’a pas besoin d’être lancé au préalable. Il demande la boîte aux lettres, recherche les messages qui correspondent aux règles d’adresse du dossier, laisse la liste entièrement décochée, convertit la sélection dans ce dossier, puis se ferme. Si </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>delete_after_export</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> est actif, seuls les messages qui portent une preuve Markdown locale complète sont supprimés du serveur.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Le dossier doit être un répertoire local existant, non symbolique, situé sous </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>notes_dir</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> et identique à une destination configurée. Tout autre chemin est refusé avant la moindre connexion IMAP.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-2">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>tray</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>tray</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> lance l’application en icône de notification, sous Windows, macOS et Linux.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown tray</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Encadré-attention">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Encadré-libellé">
    <Content>Attention</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> : </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>tray</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> et </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>contextual</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> exigent un binaire compilé avec la fonctionnalité </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>tray</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>, par exemple avec </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>cargo build --release --features tray</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>. Sans elle, </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>tray</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> n’existe pas et </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>contextual</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> s’arrête avec un message explicite.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Au premier lancement sans compte configuré, le sous-menu d’export est désactivé. Le menu de l’icône, la fenêtre de revue du routage et la mise à jour sont décrits au chapitre 7.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>

  </Story>
  
</Document>
