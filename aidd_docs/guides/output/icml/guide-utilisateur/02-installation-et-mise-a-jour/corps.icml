  <Cell Name="0:7" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>update download exceeds … bytes, refuse to install it</Content>
      </CharacterStyleRange>
