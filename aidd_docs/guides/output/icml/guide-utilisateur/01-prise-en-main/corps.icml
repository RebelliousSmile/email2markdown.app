<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Le guide se lit en deux parties. La première suffit pour utiliser l’application au quotidien : installation, puis tout se fait depuis l’icône de la zone de notification. La seconde, facultative, s’adresse à l’utilisation avancée.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
