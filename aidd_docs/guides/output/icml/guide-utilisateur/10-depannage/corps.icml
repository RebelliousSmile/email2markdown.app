      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Un message avec pièce jointe illisible n’est pas exporté</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Garde-fou de la suppression</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="2:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Récupérer la pièce jointe autrement, ou désactiver la suppression pour ce compte</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>stale-uidvalidity</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content> dans </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>deletions.log</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Le serveur a renuméroté le dossier ; le message n’a pas été touché</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="2:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Aucune action immédiate ; examiner le compte avec </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>audit-server</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>retry-required</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content> dans </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>deletions.log</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>La suppression sera retentée</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="2:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
