  <Cell Name="2:10" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Corriger sa syntaxe ; l’application ne le modifie pas</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:11" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>« destination_max_depth doit valoir au moins 1 »</Content>
      </CharacterStyleRange>
