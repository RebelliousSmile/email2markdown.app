      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:5" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>« Rien à nettoyer pour » le compte</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:5" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Aucun message à supprimer</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="2:5" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Rien à faire</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:6" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>« Nettoyer le serveur : un nettoyage est déjà en cours »</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:6" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Une opération est déjà lancée</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="2:6" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Attendre la fin</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:7" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Le menu </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Gras">
        <Content>Nettoyer le serveur</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content> est absent</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:7" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Aucun compte n’a la suppression activée</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="2:7" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Activer </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Gras">
        <Content>Supprimer après exportation</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content> pour un compte</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
</Table>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Pour comprendre l’état d’un compte, utilisez </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>email-to-markdown audit-server &lt;Compte&gt; --details</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-1">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Mise à jour</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Les erreurs de mise à jour (« GitHub API error », « No SHA256SUMS asset found in release », « No compatible asset found in release », « Download error », « failed to replace the running binary ») sont détaillées dans le chapitre « Installation et mise à jour ». Dans tous les cas, votre version actuelle reste utilisable.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-1">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>L’icône n’apparaît pas</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<Table AppliedTableStyle="TableStyle/Tableau" HeaderRowCount="1" BodyRowCount="3" ColumnCount="2">
  <Column Name="0" SingleColumnWidth="172.3179" />
  <Column Name="1" SingleColumnWidth="187.6821" />
  <Cell Name="0:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Cause</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Remède</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Icône masquée par Windows</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Déployer la flèche « Afficher les icônes cachées » de la barre des tâches</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>L’application n’est pas lancée</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Ouvrir « Email to Markdown » depuis le menu Démarrer</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Commande inconnue en ligne de commande (</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>tray</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>, </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>contextual</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>)</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Ces commandes n’existent que dans la version fournie par l’installateur, pas dans une version compilée sans l’option </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>tray</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
</Table>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Encadré-attention">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Encadré-libellé">
    <Content>Attention</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> Ne supprimez jamais à la main les fichiers </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>handled_messages.txt</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> ou </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>deletions.log</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> pour « réparer » un problème : ils conditionnent la sécurité de la suppression sur le serveur.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-1">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Réinitialiser sa configuration</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Si la configuration est irrémédiablement confuse, vous pouvez repartir de zéro en conservant vos notes :</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num" NumberingContinue="false">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Quittez l’application depuis l’icône.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Sauvegardez le dossier </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>%APPDATA%\email-to-markdown\</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> en le copiant ailleurs.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Supprimez les fichiers </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>accounts.yaml</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> et </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>settings.yaml</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>, et si besoin les mots de passe du fichier </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>.env</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Relancez l’application et redéclarez vos comptes, ou importez-les depuis Thunderbird.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Vos notes déjà exportées ne sont pas touchées. Conservez </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>handled_messages.txt</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> : il évite de réexporter des messages déjà traités.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>

  </Story>
  
</Document>
