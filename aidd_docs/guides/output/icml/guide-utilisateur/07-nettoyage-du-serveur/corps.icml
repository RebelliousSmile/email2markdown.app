        </Properties>
      </CharacterStyle>
    </RootCharacterStyleGroup>
    <RootParagraphStyleGroup Self="pandoc_paragraph_styles">
      <ParagraphStyle Self="$ID/NormalParagraphStyle" Name="$ID/NormalParagraphStyle"
          SpaceBefore="6" SpaceAfter="6"> <!-- paragraph spacing -->
        <Properties>
          <TabList type="list">
            <ListItem type="record">
              <Alignment type="enumeration">LeftAlign</Alignment>
              <AlignmentCharacter type="string">.</AlignmentCharacter>
              <Leader type="string"></Leader>
              <Position type="unit">10</Position> <!-- first tab stop -->
            </ListItem>
          </TabList>
        </Properties>
      </ParagraphStyle>
      <ParagraphStyle Self="ParagraphStyle/Intertitre-1" Name="Intertitre-1" PointSize="18">
        <Properties>
          <BasedOn type="object">$ID/NormalParagraphStyle</BasedOn>
        </Properties>
      </ParagraphStyle>
      <ParagraphStyle Self="ParagraphStyle/Intertitre-2" Name="Intertitre-2" PointSize="14">
        <Properties>
          <BasedOn type="object">$ID/NormalParagraphStyle</BasedOn>
        </Properties>
      </ParagraphStyle>
      <ParagraphStyle Self="ParagraphStyle/Courant" Name="Courant">
        <Properties>
          <BasedOn type="object">$ID/NormalParagraphStyle</BasedOn>
        </Properties>
      </ParagraphStyle>
      <ParagraphStyle Self="ParagraphStyle/Liste-num" Name="Liste-num" BulletsAndNumberingListType="NumberedList" NumberingExpression="^#.^t" NumberingLevel="1" LeftIndent="18" FirstLineIndent="-18">
        <Properties>
          <BasedOn type="object">$ID/NormalParagraphStyle</BasedOn>
        </Properties>
      </ParagraphStyle>
      <ParagraphStyle Self="ParagraphStyle/Liste-puce" Name="Liste-puce" BulletsAndNumberingListType="BulletList" LeftIndent="14" FirstLineIndent="-14">
        <Properties>
          <BasedOn type="object">$ID/NormalParagraphStyle</BasedOn>
        </Properties>
      </ParagraphStyle>
      <ParagraphStyle Self="ParagraphStyle/Tableau texte" Name="Tableau texte">
        <Properties>
          <BasedOn type="object">$ID/NormalParagraphStyle</BasedOn>
        </Properties>
      </ParagraphStyle>
      <ParagraphStyle Self="ParagraphStyle/Tableau en-tête" Name="Tableau en-tête">
        <Properties>
          <BasedOn type="object">$ID/NormalParagraphStyle</BasedOn>
        </Properties>
      </ParagraphStyle>
      <ParagraphStyle Self="ParagraphStyle/Encadré-attention" Name="Encadré-attention">
        <Properties>
          <BasedOn type="object">$ID/NormalParagraphStyle</BasedOn>
        </Properties>
      </ParagraphStyle>
      <ParagraphStyle Self="ParagraphStyle/Encadré-retenir" Name="Encadré-retenir">
        <Properties>
          <BasedOn type="object">$ID/NormalParagraphStyle</BasedOn>
        </Properties>
      </ParagraphStyle>
    </RootParagraphStyleGroup>
    <RootTableStyleGroup Self="pandoc_table_styles">
      <TableStyle Self="TableStyle/Tableau" Name="Tableau" />
    </RootTableStyleGroup>
    <RootCellStyleGroup Self="pandoc_cell_styles">
      <CellStyle Self="CellStyle/Cellule" Name="Cellule" AppliedParagraphStyle="ParagraphStyle/$ID/[No paragraph style]" />
    </RootCellStyleGroup>
    <RootObjectStyleGroup Self="cerascan_object_styles">

    </RootObjectStyleGroup>
  <Story Self="pandoc_story"
      TrackChanges="false"
      StoryTitle=""
      AppliedTOCStyle="n"
      AppliedNamedGrid="n" >
    <StoryPreference OpticalMarginAlignment="false" OpticalMarginSize="12" />

<!-- body needs to be non-indented, otherwise code blocks are indented too far -->
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-1">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Une fonction désactivée par défaut</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Par défaut, l’application ne fait que lire vos messages. La suppression sur le serveur n’a lieu que si vous l’activez explicitement, compte par compte ou pour tous les comptes.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<Table AppliedTableStyle="TableStyle/Tableau" HeaderRowCount="1" BodyRowCount="2" ColumnCount="2">
  <Column Name="0" SingleColumnWidth="109.1259" />
  <Column Name="1" SingleColumnWidth="250.8741" />
  <Cell Name="0:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Où</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Comment</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Pour tous les comptes</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Case </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Gras">
        <Content>Supprimer après exportation</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content> de l’onglet </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Gras">
        <Content>Paramètres généraux</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content> de la fenêtre </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Gras">
        <Content>Paramètres…</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Pour un compte</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Choix </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Gras">
        <Content>Oui</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content> de </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Gras">
        <Content>Supprimer après export</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content> dans le bloc </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Gras">
        <Content>Comportement</Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content> du compte</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
</Table>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>En utilisation avancée, les mêmes réglages existent dans le fichier </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>settings.yaml</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> (clé </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>delete_after_export</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>), et l’option </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>--delete-after-export</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> de la commande </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>export</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> les force pour un seul export. Ils sont décrits dans les chapitres « Fichiers de configuration » et « Commandes en ligne ».</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Encadré-attention">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Encadré-libellé">
    <Content>Attention</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> Les messages exportés sont effacés du serveur, sans retour possible. Sur Gmail, ils passent par la corbeille puis sont purgés aussitôt. Sur les autres serveurs, ils sont supprimés définitivement. Vérifiez vos premières notes avant d’activer cette option.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Pour Gmail, un mot de passe d’application est indispensable à la suppression.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-1">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Les garde-fous</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>L’application supprime un message seulement quand elle est certaine que sa note existe et que la suppression vise le bon message. Elle applique pour cela plusieurs protections.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-2">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>La preuve d’origine</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>À l’export, chaque note reçoit dans son frontmatter une </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Gras">
    <Content>preuve</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> (clé </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>source</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>) qui désigne le message exact sur le serveur : le dossier, le numéro de version du dossier (UIDVALIDITY), le numéro du message (UID), l’identifiant de message, une empreinte de ses en-têtes et, pour Gmail, l’identifiant interne du fournisseur.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Avant de supprimer, l’application relit l’en-tête du message sur le serveur et vérifie qu’il correspond bien à la preuve. Si le serveur a renuméroté ses messages entre-temps, la suppression est refusée au lieu de viser un autre message.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-2">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Le registre des messages traités</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Le fichier </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>handled_messages.txt</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>, dans le dossier de configuration, est le registre de tout ce qui a été traité, compte par compte. Il sert à éviter de réexporter un message et à retrouver ceux qui restent à supprimer.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Un message peut y être marqué comme </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Gras">
    <Content>conservé</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> (colonne </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>held</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>) : il n’est alors jamais supprimé.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-2">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Les messages que l’on garde sur le serveur</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Plusieurs situations font conserver un message sur le serveur, même avec la suppression activée :</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-puce" NumberingContinue="false">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>une pièce jointe illisible : le message n’est pas exporté du tout, car l’application refuse de supprimer ce qu’elle n’a pas pu conserver intégralement ;</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-puce">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>une image annoncée dans le message mais non conservée : le message est gardé, avec l’avertissement « Message conservé sur le serveur, image annoncée non conservée » ;</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-puce">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>une note qui n’existe plus, ou dont la preuve ne correspond plus au message visé : la suppression est refusée.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Quand un message est volontairement conservé, sa note porte la clé </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>keep_on_server</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> avec la raison.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Encadré-retenir">
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Encadré-libellé">
    <Content>À retenir</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> En cas de doute, l’application conserve le message. Elle ne supprime jamais « au jugé » : une suppression exige une note existante, une preuve valable et une correspondance confirmée avec le serveur.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-1">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Le journal des suppressions</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Chaque tentative de suppression est consignée dans le fichier </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>deletions.log</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> du dossier de configuration. Chaque ligne contient, séparés par des tabulations : l’heure, le compte, le dossier, le numéro du message, l’identifiant du message et le résultat.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<Table AppliedTableStyle="TableStyle/Tableau" HeaderRowCount="1" BodyRowCount="6" ColumnCount="2">
  <Column Name="0" SingleColumnWidth="173.0204" />
  <Column Name="1" SingleColumnWidth="186.9796" />
  <Cell Name="0:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Résultat</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Signification</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>deleted</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Le message a été supprimé</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>already-absent</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Le message n’était plus sur le serveur</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>retry-required: …</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>La suppression n’a pas abouti et sera retentée (par exemple, il manque une information propre à Gmail)</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>stale-uidvalidity: expected X, found Y</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Le serveur a renuméroté le dossier : le message n’a pas été touché</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:5" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>rejected: …</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:5" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>La suppression a été refusée par les garde-fous, avec la raison</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:6" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>error: …</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:6" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Une erreur est survenue pendant la suppression d’un lot</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
</Table>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Ce journal est votre trace d’audit : ouvrez-le avec un éditeur de texte pour savoir précisément ce qui a été supprimé, quand et pourquoi une suppression a été refusée.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-1">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>La commande « Nettoyer le serveur »</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Il peut rester sur le serveur des messages déjà triés ou écartés (par exemple, parce que vous avez activé la suppression après avoir exporté). L’entrée </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Gras">
    <Content>Nettoyer le serveur</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> de l’icône les supprime en une fois. Elle n’apparaît que si au moins un compte a la suppression activée, et propose un élément par compte concerné.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-2">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Déroulement</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num" NumberingContinue="false">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>L’application fait le </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Gras">
    <Content>recensement</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> des messages concernés sur le serveur.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Si des messages traités n’ont pas de preuve dans le registre, elle tente de la reconstituer à partir des notes déjà classées dans votre dossier de notes.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Elle vous demande une </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Gras">
    <Content>confirmation</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>, qui par défaut est sur « Non ».</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Après votre accord, elle supprime les messages et affiche un bilan.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-2">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>La confirmation</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>La fenêtre indique combien de messages du compte sont déjà triés ou écartés mais restent sur le serveur. Elle précise que le registre ne connaît ces messages que par leur identifiant de message, donc que l’appariement repose sur cet identifiant seul. Elle rappelle ensuite que la suppression est irréversible : pour Gmail, les messages passent par la corbeille d’où ils sont aussitôt purgés ; pour les autres serveurs, le serveur ne les conserve pas.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Enfin, elle demande « Les supprimer du serveur ? ». Sous Windows, il s’agit d’une boîte de dialogue Oui / Non au premier plan, dont le choix par défaut est Non.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-2">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Le bilan</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Le résultat est de la forme « N supprimé(s), N déjà absent(s), N échec(s) », complété selon le cas :</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<Table AppliedTableStyle="TableStyle/Tableau" HeaderRowCount="1" BodyRowCount="3" ColumnCount="2">
  <Column Name="0" SingleColumnWidth="177.4" />
  <Column Name="1" SingleColumnWidth="182.6" />
  <Cell Name="0:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Mention</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Signification</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>N preuve(s) retrouvée(s) dans les notes, purgées au prochain export</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Des preuves ont été reconstituées ; les messages seront supprimés lors du prochain export</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>N message(s) traité(s) avec preuve, supprimés par l’export (lancer Exporter)</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Ces messages seront supprimés par un export ordinaire</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>N message(s) impossibles à cibler exactement, laissés sur le serveur</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Sans preuve fiable, l’application s’abstient</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
</Table>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Si rien n’est à supprimer, le message est « Rien à nettoyer pour » suivi du compte. Si vous refusez, il est « Nettoyage annulé, rien n’a été supprimé ».</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-2">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Les refus et erreurs</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<Table AppliedTableStyle="TableStyle/Tableau" HeaderRowCount="1" BodyRowCount="6" ColumnCount="2">
  <Column Name="0" SingleColumnWidth="179.349" />
  <Column Name="1" SingleColumnWidth="180.651" />
  <Cell Name="0:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Message</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:0" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau en-tête">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Cause</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Compte « X » introuvable</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:1" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Le compte n’existe plus dans la configuration</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>X ne supprime pas les messages du serveur</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:2" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>La suppression n’est pas activée pour ce compte</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Aucun mot de passe pour X, vérifier le fichier </Content>
      </CharacterStyleRange>
      <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
        <Content>.env</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:3" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Le mot de passe est absent</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Connexion au serveur impossible</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:4" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Problème de réseau, d’identifiants ou de serveur</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:5" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Lecture de la configuration impossible</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:5" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Le fichier de comptes ou de réglages est illisible</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="0:6" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Nettoyer le serveur : un nettoyage est déjà en cours</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
  <Cell Name="1:6" AppliedCellStyle="CellStyle/Cellule">
    <ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tableau texte">
      <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
        <Content>Une autre opération de nettoyage tourne déjà</Content>
      </CharacterStyleRange>
    </ParagraphStyleRange>
  </Cell>
</Table>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Pendant l’opération, l’infobulle de l’icône indique « Nettoyage du serveur en cours » suivi du compte, puis l’étape en cours.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-1">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Comprendre ce qui reste</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Courant">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Avant de nettoyer, vous pouvez examiner l’état d’un compte sans rien modifier : la commande </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>audit-server</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>, décrite dans le chapitre « Commandes en ligne », recense les messages encore présents sur le serveur et indique pourquoi : traités avec preuve, traités sans preuve, en attente de tri dans le dossier de transit, ou jamais exportés.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Intertitre-1">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Bonnes pratiques</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num" NumberingContinue="false">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Exportez d’abord sans suppression, et vérifiez plusieurs notes, pièces jointes comprises.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Sauvegardez votre dossier de notes avant la première suppression.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Activez la suppression pour un seul compte au début.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Consultez </Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Code-inline">
    <Content>deletions.log</Content>
  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> après les premiers exports.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Liste-num">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Pour Gmail, vérifiez que le mot de passe d’application est bien renseigné.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
<Br />
</Story>
  
</Document>
